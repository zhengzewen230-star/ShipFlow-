<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shipflow.quote.mapper.QuoteMapper">
  <resultMap id="quoteMap" type="com.shipflow.quote.domain.model.Quote">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/><arg column="tenant_id" javaType="java.lang.Long"/>
      <arg column="quote_no" javaType="string"/><arg column="store_id" javaType="java.lang.Long"/>
      <arg column="channel_id" javaType="java.lang.Long"/><arg column="price_rule_id" javaType="java.lang.Long"/>
      <arg column="rule_version_no" javaType="_int"/><arg column="declared_weight" javaType="java.math.BigDecimal"/>
      <arg column="declared_length" javaType="java.math.BigDecimal"/><arg column="declared_width" javaType="java.math.BigDecimal"/>
      <arg column="declared_height" javaType="java.math.BigDecimal"/><arg column="declared_volume_weight" javaType="java.math.BigDecimal"/>
      <arg column="declared_chargeable_weight" javaType="java.math.BigDecimal"/><arg column="amount" javaType="java.math.BigDecimal"/>
      <arg column="currency" javaType="string"/><arg column="fee_detail" javaType="string"/>
      <arg column="valid_from" javaType="java.time.LocalDateTime"/><arg column="valid_to" javaType="java.time.LocalDateTime"/>
      <arg column="status" javaType="string"/><arg column="version" javaType="_long"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/>
    </constructor>
  </resultMap>
  <sql id="columns">id,tenant_id,quote_no,store_id,channel_id,price_rule_id,rule_version_no,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,amount,currency,fee_detail,valid_from,valid_to,status,version,created_at,updated_at</sql>
  <select id="findById" resultMap="quoteMap">SELECT <include refid="columns"/> FROM quote WHERE id=#{quoteId} AND tenant_id=#{tenantId}</select>
  <select id="findByQuoteNo" resultMap="quoteMap">SELECT <include refid="columns"/> FROM quote WHERE tenant_id=#{tenantId} AND quote_no=#{quoteNo}</select>
  <sql id="queryFilters">
    tenant_id=#{tenantId}
    <if test="storeId != null">AND store_id=#{storeId}</if>
    <if test="channelId != null">AND channel_id=#{channelId}</if>
    <if test="status != null and status != ''">AND status=#{status}</if>
  </sql>
  <select id="findPage" resultMap="quoteMap">
    SELECT <include refid="columns"/> FROM quote
    WHERE <include refid="queryFilters"/>
    ORDER BY created_at DESC, id DESC LIMIT #{offset},#{pageSize}
  </select>
  <select id="count" resultType="long">
    SELECT COUNT(1) FROM quote WHERE <include refid="queryFilters"/>
  </select>
  <select id="hasShipmentOrder" resultType="boolean">
    SELECT EXISTS(SELECT 1 FROM shipment_order WHERE tenant_id=#{tenantId} AND quote_id=#{quoteId})
  </select>
  <insert id="insert">INSERT INTO quote (tenant_id,quote_no,store_id,channel_id,price_rule_id,rule_version_no,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,amount,currency,fee_detail,valid_from,valid_to,status,version) VALUES (#{tenantId},#{quoteNo},#{storeId},#{channelId},#{priceRuleId},#{ruleVersionNo},#{declaredWeight},#{declaredLength},#{declaredWidth},#{declaredHeight},#{volumeWeight},#{chargeableWeight},#{amount},#{currency},#{feeDetail},#{validFrom},#{validTo},#{status},#{version})</insert>
</mapper>
