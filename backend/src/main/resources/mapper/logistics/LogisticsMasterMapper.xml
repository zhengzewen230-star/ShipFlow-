<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shipflow.logistics.mapper.LogisticsMasterMapper">
  <resultMap id="providerMap" type="com.shipflow.logistics.domain.model.LogisticsProvider"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="provider_code" javaType="string"/><arg column="provider_name" javaType="string"/><arg column="status" javaType="string"/><arg column="version" javaType="_long"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
  <resultMap id="channelMap" type="com.shipflow.logistics.mapper.LogisticsChannelRow"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="provider_id" javaType="java.lang.Long"/><arg column="channel_code" javaType="string"/><arg column="channel_name" javaType="string"/><arg column="transport_mode" javaType="com.shipflow.logistics.domain.model.LogisticsChannel$TransportMode"/><arg column="service_area" javaType="string"/><arg column="status" javaType="string"/><arg column="version" javaType="_long"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
  <resultMap id="priceRuleMap" type="com.shipflow.logistics.mapper.PriceRuleRow"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="channel_id" javaType="java.lang.Long"/><arg column="version_no" javaType="_int"/><arg column="rule_name" javaType="string"/><arg column="currency" javaType="string"/><arg column="volume_divisor" javaType="java.math.BigDecimal"/><arg column="rounding_mode" javaType="com.shipflow.logistics.domain.model.PublishedPriceRule$RoundingMode"/><arg column="rounding_increment" javaType="java.math.BigDecimal"/><arg column="effective_from" javaType="java.time.LocalDateTime"/></constructor></resultMap>
  <resultMap id="tierMap" type="com.shipflow.logistics.domain.model.PriceRuleTier"><constructor><arg column="tier_no" javaType="_int"/><arg column="min_weight" javaType="java.math.BigDecimal"/><arg column="max_weight" javaType="java.math.BigDecimal"/><arg column="billing_mode" javaType="com.shipflow.logistics.domain.model.PriceRuleTier$BillingMode"/><arg column="first_weight" javaType="java.math.BigDecimal"/><arg column="first_fee" javaType="java.math.BigDecimal"/><arg column="additional_weight" javaType="java.math.BigDecimal"/><arg column="additional_fee" javaType="java.math.BigDecimal"/><arg column="tier_fee" javaType="java.math.BigDecimal"/></constructor></resultMap>
  <sql id="providerColumns">id, provider_code, provider_name, status, version, created_at, updated_at</sql>
  <sql id="channelColumns">id, provider_id, channel_code, channel_name, transport_mode, service_area, status, version, created_at, updated_at</sql>
  <select id="findProvider" resultMap="providerMap">SELECT <include refid="providerColumns"/> FROM logistics_provider WHERE id=#{providerId} AND deleted=0</select>
  <select id="findProviderByCode" resultMap="providerMap">SELECT <include refid="providerColumns"/> FROM logistics_provider WHERE provider_code=#{providerCode} AND deleted=0</select>
  <select id="pageProviders" resultMap="providerMap">SELECT <include refid="providerColumns"/> FROM logistics_provider WHERE deleted=0 AND (#{status} IS NULL OR status=#{status}) ORDER BY id LIMIT #{offset},#{pageSize}</select>
  <select id="countProviders" resultType="long">SELECT COUNT(id) FROM logistics_provider WHERE deleted=0 AND (#{status} IS NULL OR status=#{status})</select>
  <insert id="insertProvider">INSERT INTO logistics_provider (provider_code,provider_name,status,deleted,version) VALUES (#{providerCode},#{providerName},#{status},0,0)</insert>
  <update id="updateProvider">UPDATE logistics_provider SET provider_name=#{providerName},status=#{status},version=version+1 WHERE id=#{providerId} AND deleted=0 AND version=#{version}</update>
  <select id="findChannel" resultMap="channelMap">SELECT <include refid="channelColumns"/> FROM logistics_channel WHERE id=#{channelId} AND deleted=0</select>
  <select id="findChannelByCode" resultMap="channelMap">SELECT <include refid="channelColumns"/> FROM logistics_channel WHERE provider_id=#{providerId} AND channel_code=#{channelCode} AND deleted=0</select>
  <select id="pageChannels" resultMap="channelMap">SELECT <include refid="channelColumns"/> FROM logistics_channel WHERE deleted=0 AND (#{providerId} IS NULL OR provider_id=#{providerId}) AND (#{status} IS NULL OR status=#{status}) ORDER BY id LIMIT #{offset},#{pageSize}</select>
  <select id="countChannels" resultType="long">SELECT COUNT(id) FROM logistics_channel WHERE deleted=0 AND (#{providerId} IS NULL OR provider_id=#{providerId}) AND (#{status} IS NULL OR status=#{status})</select>
  <insert id="insertChannel">INSERT INTO logistics_channel (provider_id,channel_code,channel_name,transport_mode,service_area,status,deleted,version) VALUES (#{providerId},#{channelCode},#{channelName},#{transportMode},#{serviceArea},#{status},0,0)</insert>
  <update id="updateChannel">UPDATE logistics_channel SET channel_name=#{channelName},transport_mode=#{transportMode},service_area=#{serviceArea},status=#{status},version=version+1 WHERE id=#{channelId} AND deleted=0 AND version=#{version}</update>
  <select id="findServiceCountries" resultType="string">SELECT country_code FROM logistics_channel_service_country WHERE channel_id=#{channelId} ORDER BY country_code</select>
  <delete id="deleteServiceCountries">DELETE FROM logistics_channel_service_country WHERE channel_id=#{channelId}</delete>
  <insert id="insertServiceCountry">INSERT INTO logistics_channel_service_country (channel_id,country_code) VALUES (#{channelId},#{countryCode})</insert>
  <select id="hasPublishedPriceRule" resultType="boolean">SELECT EXISTS(SELECT 1 FROM price_rule WHERE channel_id=#{channelId} AND status='PUBLISHED')</select>
  <insert id="insertPublishedPriceRule">INSERT INTO price_rule (channel_id,version_no,rule_name,currency,volume_divisor,rounding_mode,rounding_increment,status,effective_from) VALUES (#{channelId},#{versionNo},#{ruleName},#{currency},#{volumeDivisor},#{roundingMode},#{roundingIncrement},'PUBLISHED',#{effectiveFrom})</insert>
  <select id="findPriceRuleId" resultType="long">SELECT id FROM price_rule WHERE channel_id=#{channelId} AND version_no=#{versionNo}</select>
  <select id="findPublishedPriceRule" resultMap="priceRuleMap">SELECT id,channel_id,version_no,rule_name,currency,volume_divisor,rounding_mode,rounding_increment,effective_from FROM price_rule WHERE id=#{priceRuleId} AND status='PUBLISHED'</select>
  <select id="findPriceRuleTiers" resultMap="tierMap">SELECT tier_no,min_weight,max_weight,billing_mode,first_weight,first_fee,additional_weight,additional_fee,tier_fee FROM price_rule_tier WHERE price_rule_id=#{priceRuleId} ORDER BY tier_no</select>
  <insert id="insertPriceRuleTier">INSERT INTO price_rule_tier (price_rule_id,tier_no,min_weight,max_weight,billing_mode,first_weight,first_fee,additional_weight,additional_fee,tier_fee) VALUES (#{priceRuleId},#{tier.tierNo},#{tier.minWeight},#{tier.maxWeight},#{tier.billingMode},#{tier.firstWeight},#{tier.firstFee},#{tier.additionalWeight},#{tier.additionalFee},#{tier.tierFee})</insert>
</mapper>
