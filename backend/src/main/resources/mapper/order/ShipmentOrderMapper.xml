<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shipflow.order.mapper.ShipmentOrderMapper">
 <resultMap id="orderMap" type="com.shipflow.order.domain.model.ShipmentOrder"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="tenant_id" javaType="java.lang.Long"/><arg column="order_no" javaType="string"/><arg column="idempotency_key" javaType="string"/><arg column="store_id" javaType="java.lang.Long"/><arg column="quote_id" javaType="java.lang.Long"/><arg column="channel_id" javaType="java.lang.Long"/><arg column="current_status" javaType="string"/><arg column="origin_country" javaType="string"/><arg column="destination_country" javaType="string"/><arg column="declared_weight" javaType="java.math.BigDecimal"/><arg column="declared_length" javaType="java.math.BigDecimal"/><arg column="declared_width" javaType="java.math.BigDecimal"/><arg column="declared_height" javaType="java.math.BigDecimal"/><arg column="declared_volume_weight" javaType="java.math.BigDecimal"/><arg column="declared_chargeable_weight" javaType="java.math.BigDecimal"/><arg column="estimated_fee" javaType="java.math.BigDecimal"/><arg column="currency" javaType="string"/><arg column="created_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
 <sql id="columns">id,tenant_id,order_no,idempotency_key,store_id,quote_id,channel_id,current_status,origin_country,destination_country,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,estimated_fee,currency,created_at</sql>
 <select id="findByIdempotencyKey" resultMap="orderMap">SELECT <include refid="columns"/> FROM shipment_order WHERE tenant_id=#{tenantId} AND idempotency_key=#{idempotencyKey}</select>
 <select id="findByQuoteId" resultMap="orderMap">SELECT <include refid="columns"/> FROM shipment_order WHERE tenant_id=#{tenantId} AND quote_id=#{quoteId}</select>
 <insert id="insertOrder">INSERT INTO shipment_order (tenant_id,order_no,idempotency_key,store_id,quote_id,channel_id,current_status,origin_country,destination_country,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,estimated_fee,current_fee,currency,version) VALUES (#{tenantId},#{orderNo},#{idempotencyKey},#{storeId},#{quoteId},#{channelId},#{currentStatus},#{originCountry},#{destinationCountry},#{declaredWeight},#{declaredLength},#{declaredWidth},#{declaredHeight},#{volumeWeight},#{chargeableWeight},#{estimatedFee},#{estimatedFee},#{currency},0)</insert>
 <insert id="insertSnapshot">INSERT INTO shipment_quote_snapshot (tenant_id,shipment_order_id,quote_id,price_rule_id,rule_version_no,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,volume_divisor,rounding_mode,rounding_increment,fee_detail,amount,currency,valid_from,valid_to) VALUES (#{tenantId},#{orderId},#{quote.id},#{quote.priceRuleId},#{quote.ruleVersionNo},#{quote.declaredWeight},#{quote.declaredLength},#{quote.declaredWidth},#{quote.declaredHeight},#{quote.volumeWeight},#{quote.chargeableWeight},#{volumeDivisor},#{roundingMode},#{roundingIncrement},#{quote.feeDetail},#{quote.amount},#{quote.currency},#{quote.validFrom},#{quote.validTo})</insert>
 <insert id="insertAddress">INSERT INTO shipment_address (tenant_id,shipment_order_id,address_type,contact_name,phone,company_name,email,country_code,state_province,city,district,address_line1,address_line2,postal_code) VALUES (#{tenantId},#{orderId},#{type},#{address.contactName},#{address.phone},#{address.companyName},#{address.email},#{address.countryCode},#{address.stateProvince},#{address.city},#{address.district},#{address.addressLine1},#{address.addressLine2},#{address.postalCode})</insert>
 <insert id="insertPackage">INSERT INTO shipment_package (tenant_id,shipment_order_id,package_no,declared_weight,declared_length,declared_width,declared_height,declared_volume_weight,declared_chargeable_weight,status) VALUES (#{tenantId},#{orderId},#{packageNo},#{order.declaredWeight},#{order.declaredLength},#{order.declaredWidth},#{order.declaredHeight},#{order.volumeWeight},#{order.chargeableWeight},'CREATED')</insert>
 <select id="findPackageId" resultType="long">SELECT id FROM shipment_package WHERE tenant_id=#{tenantId} AND shipment_order_id=#{orderId}</select>
 <insert id="insertItem">INSERT INTO shipment_item (tenant_id,shipment_package_id,item_no,sku,product_name,quantity,unit_price,currency,hs_code,country_of_origin) VALUES (#{tenantId},#{packageId},#{itemNo},#{item.sku},#{item.productName},#{item.quantity},#{item.unitPrice},#{item.currency},#{item.hsCode},#{item.countryOfOrigin})</insert>
 <insert id="insertAudit">INSERT INTO audit_log (tenant_id,operator_user_id,action_type,resource_type,resource_id,request_id,result_status,occurred_at) VALUES (#{tenantId},#{operatorUserId},'CREATE','SHIPMENT_ORDER',#{orderId},#{requestId},'SUCCESS',#{occurredAt})</insert>
</mapper>
